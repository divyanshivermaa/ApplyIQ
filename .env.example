DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENV=production

# Comma-separated frontend/API origins allowed by FastAPI CORS.
CORS_ORIGINS=https://your-frontend.example.com

# Use true when auth cookies are served over HTTPS.
COOKIE_SECURE=true

# Background jobs
SCHEDULER_TIMEZONE=Asia/Kolkata
FOLLOWUP_DAILY_HOUR=9
FOLLOWUP_DAILY_MINUTE=0
FOLLOWUP_JOB_ENABLED=true

# Keep disabled outside local development.
ADMIN_DEV_ENDPOINTS_ENABLED=false
